---
import { getCollection } from 'astro:content';
import GameConsole from '../../../components/GameConsole.astro';
import '../../../styles/global.css';

export async function getStaticPaths() {
  const missions = await getCollection('missions');
  return missions.map((mission) => ({
    params: { lang: mission.data.lang, slug: mission.id.replace(/\.md$/, '').replace(/-(ru|en)$/, '') },
    props: { mission },
  }));
}

const { mission } = Astro.props;
const d = mission.data;
const lang = d.lang;
const slug = mission.id.replace(/\.md$/, '').replace(/-(ru|en)$/, '');
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const ASSETS = d.assets || 'sfak';
const BONUSES = d.bonusOptions || (lang === 'ru' ? ['Руда', 'Кристаллы', 'Ammo Cart War Machine'] : ['Ore', 'Crystals', 'Ammo Cart War Machine']);
const img = (p: string) => base + 'images/' + p;

function slugify(s: string) {
  return s.toLowerCase().replace(/[^a-z0-9]+/gi, '-').replace(/^-+|-+$/g, '');
}
function cardPaths(file: string, kind: string): string[] {
  const shared = 'cards/' + file;
  const sharedLang = 'cards/' + lang + '/' + file;
  const mis = ASSETS + '/cards/' + file;
  const misLang = ASSETS + '/cards/' + lang + '/' + file;
  if (kind === 'spec') return [misLang, mis, sharedLang, shared];
  return [sharedLang, shared];
}
function fbAttr(list: string[]): string {
  return list.slice(1).map(function (p) { return base + 'images/' + p; }).join('|');
}
const ONERR = "const n=(this.dataset.fallback||'').split('|').filter(Boolean);if(n.length){this.dataset.fallback=n.slice(1).join('|');this.src=n[0];}else{this.style.display='none'}";
function cardImg(card: any) {
  if (card.img) return { src: base + 'images/' + card.img, fb: '' };
  const name = slugify(card.title || '');
  const amt = (card.amount || '').toLowerCase();
  const a = (amt ? amt + '-' + name : name) + '.png';
  const b = (amt ? name + '-' + amt : name) + '.png';
  const list = cardPaths(a, 'unit').concat(cardPaths(b, 'unit'));
  return { src: base + 'images/' + list[0], fb: fbAttr(list) };
}

const KW: Record<string, string> = { Statistic: 'kw-stat', Specialty: 'kw-spec', Ability: 'kw-abil', Spell: 'kw-spell' };
function deckHtml(c: string) {
  const i = c.lastIndexOf(' ');
  const last = c.slice(i + 1);
  const cls = KW[last];
  return cls ? c.slice(0, i + 1) + '<span class="' + cls + '">' + last + '</span>' : c;
}

const STARS: Record<string, string> = {
  'Few Centaurs': 'star-o', 'Few Dwarves': 'star-o', 'Few Elves': 'star-w',
  'Pack Skeletons': 'star-o', 'Pack Zombies': 'star-o', 'Few Liches': 'star-w',
  'Rogues': 'star-o', 'Pack Vampires': 'star-w', 'Pack Liches': 'star-w',
  'Mummies': 'star-w', 'Pack Dread Knights': 'star-g', 'Few Black Dragons': 'star-g',
};
function starFor(name: string) {
  const cls = STARS[name.trim()];
  return cls ? '\u00A0<span class="' + cls + '">★</span>' : '';
}

const counts: Record<string, number> = {};
for (const c of d.mainHero.handDeck) {
  const m = c.match(/^(\d+)\s*x\s+(.+)$/i);
  if (!m) continue;
  const n = Number(m[1]);
  const name = m[2].toLowerCase();
  if (name.includes('attack')) counts.attack = n;
  else if (name.includes('defense')) counts.defense = n;
  else if (name.includes('power')) counts.power = n;
  else if (name.includes('knowledge')) counts.knowledge = n;
}
const statCards = [
  { c: 'attack.png', n: counts.attack },
  { c: 'defense.png', n: counts.defense },
  { c: 'power.png', n: counts.power },
  { c: 'knowledge.png', n: counts.knowledge },
].filter(function (o) { return (o.n || 0) > 0; });
const skillCards = d.mainHero.handDeck
  .map(function (c: string) {
    const m = c.match(/^(\d+)\s*x\s+(.+)$/i);
    if (!m) return null;
    const name = m[2].trim();
    const words = name.split(' ');
    const last = words[words.length - 1];
    if (last !== 'Specialty' && last !== 'Ability' && last !== 'Spell') return null;
    const kind = last === 'Specialty' ? 'spec' : (last === 'Ability' ? 'ability' : 'spell');
    return { n: Number(m[1]), c: slugify(name) + '.png', kind: kind };
  })
  .filter(function (o) { return o !== null; });
const unitCards = d.mainHero.army.split(',').map(function (a: string) { return slugify(a) + '.png'; });
function deckCounts(hand: string[]) {
  const c: Record<string, number> = {};
  for (const ln of hand) {
    const m = ln.match(/^(\d+)\s*x\s+(.+)$/i);
    if (!m) continue;
    const n = Number(m[1]);
    const nm = m[2].toLowerCase();
    if (nm.includes('attack')) c.attack = n;
    else if (nm.includes('defense')) c.defense = n;
    else if (nm.includes('power')) c.power = n;
    else if (nm.includes('knowledge')) c.knowledge = n;
  }
  return c;
}
const heroSource: any[] = (d.heroes && d.heroes.length) ? d.heroes : [{ name: '', img: '', army: d.mainHero.army, handDeck: d.mainHero.handDeck }];
const heroBlocks = heroSource.map(function (h: any) {
  const cnt = deckCounts(h.handDeck);
  return {
    name: h.name || '',
    imgSrc: h.img ? img(h.img) : img(ASSETS + '/hero.png'),
    army: h.army,
    hand: h.handDeck,
    stats: [
      { c: 'attack.png', n: cnt.attack },
      { c: 'defense.png', n: cnt.defense },
      { c: 'power.png', n: cnt.power },
      { c: 'knowledge.png', n: cnt.knowledge },
    ].filter(function (o) { return (o.n || 0) > 0; }),
    skills: h.handDeck.map(function (c: string) {
      const m = c.match(/^(\d+)\s*x\s+(.+)$/i);
      if (!m) return null;
      const name = m[2].trim();
      const words = name.split(' ');
      const last = words[words.length - 1];
      if (last !== 'Specialty' && last !== 'Ability' && last !== 'Spell') return null;
      const kind = last === 'Specialty' ? 'spec' : (last === 'Ability' ? 'ability' : 'spell');
      return { n: Number(m[1]), c: slugify(name) + '.png', kind: kind };
    }).filter(function (o: any) { return o !== null; }),
    units: h.army.split(',').map(function (a: string) { return slugify(a) + '.png'; }),
  };
});

const t = lang === 'ru' ? {
  mapTitle: 'КАРТА', townTitle: 'ГЛАВНЫЙ ГОРОД', heroTitle: 'ГЛАВНЫЙ ГЕРОЙ',
  aiTitle: 'НАСТРОЙКИ ИИ', winTitle: 'УСЛОВИЯ ПОБЕДЫ',
  check: 'До начала игры проверьте:',
  tabMap: 'Настройки Карты', tabTown: 'Настройки Главного Города',
  tabHero: 'Настройки Главного Героя', tabAi: 'Настройки ИИ', tabWin: 'Условия Победы',
  mapSettings: 'Настройки Карты:', townSettings: 'Настройки:', heroSettings: 'Настройки:',
  army: 'Армия :', yourDeck: 'Ваша колода:', handDeckTitle: 'Ваша Колода:', aiDeck: 'Колода:',
  starting: 'Стартовые фрагменты (I):', far: 'Дальние фрагменты (II-III):',
  near: 'Ближние фрагменты (IV-V):', additional: 'Дополнительно :',
  buildings: 'Возведено :', production: 'Доход:', startRes: 'Стартовые ресурсы:',
  goals: 'Условия победы(победить):', lose: 'Условия поражения:', rules: 'Дополнительные правила:',
  begin: 'НАЧАТЬ', back: 'НАЗАД', machine: 'Ammo Cart War Machine',
  diffNames: ['Лёгкий', 'Средний', 'Сложный', 'Невозможный'],
  bonusNames: ['Руда', 'Кристаллы', 'Ammo Cart War Machine'],
} : {
  mapTitle: 'MAP', townTitle: 'MAIN TOWN', heroTitle: 'MAIN HERO',
  aiTitle: 'AI SETTINGS', winTitle: 'WIN CONDITIONS',
  check: 'Please check before starting the game :',
  tabMap: 'Map Settings', tabTown: 'Main Town Settings',
  tabHero: 'Main Hero Settings', tabAi: 'AI Settings', tabWin: 'Win Conditions',
  mapSettings: 'Map Settings:', townSettings: 'Main Town Settings:', heroSettings: 'Main Hero Settings:',
  army: 'Army :', yourDeck: 'Hand Deck:', handDeckTitle: 'Hand Deck:', aiDeck: 'Deck:',
  starting: 'Starting Map tile (I):', far: 'Far Map tile (II-III):',
  near: 'Near Map tile (IV-V):', additional: 'Additionally :',
  buildings: 'Town Buildings :', production: 'Production:', startRes: 'Starting Resources:',
  goals: 'Win Conditions(defeat):', lose: 'Lose Conditions:', rules: 'ADDITIONAL RULES:',
  begin: 'BEGIN', back: 'BACK', machine: 'Ammo Cart War Machine',
  diffNames: ['Easy', 'Medium', 'Hard', 'Impossible'],
  bonusNames: ['Ore', 'Crystals', 'Ammo Cart War Machine'],
};

const aiOrder = ['Aislinn', 'Galthran', 'Town', "Lord Fayette's Guards", 'Lord Fayette'];
const aiSorted = [...d.aiSettings].sort((a: any, b: any) => aiOrder.indexOf(a.name) - aiOrder.indexOf(b.name));
const prod = d.mainTown.production.split(' ');
const res = d.mainTown.startingResources.split(' ');
const resIcons = ['gold.png', 'ore.png', 'crystal.png'];
const BICON: Record<string, string> = { bronze: 'star-o', silver: 'star-w', gold: 'star-g', citadel: 'b-icon' };
const BCHAR: Record<string, string> = { bronze: '★', silver: '★', gold: '★', citadel: '🏰' };
function bonusIconFor(text: string): string {
  const s = String(text).toLowerCase();
  if (s.includes('кристал') || s.includes('crystal')) return 'crystal.png';
  if (s.includes('золот') || s.includes('gold')) return 'gold.png';
  if (s.includes('руд') || s.includes('ore')) return 'ore.png';
  if (s.includes('артефакт') || s.includes('artifact')) return 'artifact.png';
  if (s.includes('улучш') || s.includes('бойцов') || s.includes('reinforce') || s.includes('upgrade')) return 'upgrade.png';
  if (s.includes('поиск') || s.includes('search')) return 'spell.png';
  return 'cart.png';
}
const bonusIcons = d.bonusOptions ? d.bonusOptions.map(bonusIconFor) : ['ore.png', 'crystal.png', 'cart.png'];
const allMissions = await getCollection('missions');
const langMissions = allMissions.filter((m: any) => m.data.lang === lang);
const byFaction: Record<number, any[]> = {};
for (const m of langMissions) {
  const f = Number((m.data as any).faction ?? 1);
  if (!byFaction[f]) byFaction[f] = [];
  byFaction[f].push(m);
}
for (const k of Object.keys(byFaction)) byFaction[k].sort((a: any, b: any) => Number(a.data.order ?? 0) - Number(b.data.order ?? 0));
const FACTION_COUNT = 13;
const soonWord = lang === 'ru' ? 'Скоро…' : 'Soon…'; 
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{d.title} | Heroes III Board Game</title>
</head>
<body style={`--tex-stone:url('${img('ui/stone.jpg')}'); --tex-blue:url('${img('ui/blue.jpg')}')`}>
  <div class="topbar">{d.title}</div>

  <div class="screen">
          <aside class="filmstrip" style="display:flex;flex-direction:column;gap:3px;align-items:flex-start;overflow:visible">
      {Array.from({ length: FACTION_COUNT }).map((_, fi) => (
        <div class="faction-slot" style="position:relative;flex:0 0 auto;width:46px">
          <img class:list={['thumb', { sel: fi === Number(d.faction ?? 1) }]} style="width:46px;height:32px;object-fit:cover;display:block" src={img(`ui/thumb/t${fi + 1}.png`)} alt="" onerror="this.onerror=null;this.outerHTML='<span style=&quot;display:flex;align-items:center;justify-content:center;width:46px;height:32px;font-size:1.1rem;background:#20242a&quot;>🏰</span>'" />
          <div class="faction-pop" style="display:none;position:absolute;left:46px;top:-6px;padding-left:10px;gap:10px;z-index:60;flex-direction:row;align-items:flex-start">
                        {(byFaction[fi] || []).length
              ? (byFaction[fi] || []).map((m: any) => (
                  <a href={`${base}${lang}/mission/${m.id.replace(/\.md$/, '').replace(/-(ru|en)$/, '')}/`} style={`flex:0 0 auto;display:block;padding:8px 16px;background:#1d2a5e url('${img('ui/blue.jpg')}') center/cover;border:2px solid #a8863c;box-shadow:0 0 0 1px #000, inset 0 0 12px rgba(0,0,0,.55);color:#e9c464;font-family:inherit;font-size:1rem;line-height:1.2;white-space:nowrap;text-decoration:none`}>
                    {m.data.title}
                  </a>
                ))
              : [0, 1, 2].map(() => <span style={`flex:0 0 auto;display:block;padding:8px 16px;background:#1d2a5e url('${img('ui/blue.jpg')}') center/cover;border:2px solid #5a5e63;color:#9aa0a8;font-family:inherit;font-size:1rem;line-height:1.2;white-space:nowrap`}>{soonWord}</span>)}
          </div>
        </div>
      ))}
    </aside>

    <main class="stage" id="stage">
      <!-- КАРТА -->
      <section class="tab-pane active" id="pane-map">
        <h1 class="stage-title">{t.mapTitle}</h1>
        <div class="visual">
          <button class="nav-arrow" data-dir="-1"><img src={img('ui/arrow-left.png')} alt="◄" onerror="this.parentNode.textContent='◄'" /></button>
          <img class="visual-img clean" src={img(ASSETS + '/map.png')} alt="Map" onerror="this.style.display='none'" />
          <button class="nav-arrow" data-dir="1"><img src={img('ui/arrow-right.png')} alt="►" onerror="this.parentNode.textContent='►'" /></button>
        </div>
        <div class="squares">
          {['map', 'town', 'hero', 'ai', 'win'].map((tab) => (
            <button class="sq" data-goto={tab}></button>
          ))}
        </div>
        <h3 class="set-title" style="text-align:left">{t.mapSettings}</h3>
        <div class="map-cols">
          <div>
            <p class="col-head">{t.starting}</p>
            <ul class="game-list" style="white-space:nowrap">{d.mapSettings.starting.split(/, (?=\d)/).map((a: string) => <li>{a.trim()}</li>)}</ul>
          </div>
          <div>
            <p class="col-head">{t.far}</p>
            <ul class="game-list" style="white-space:nowrap">{d.mapSettings.far.split(/, (?=\d)/).map((a: string) => <li>{a.trim()}</li>)}</ul>
          </div>
          <div>
            <p class="col-head">{t.near}</p>
            <ul class="game-list" style="white-space:nowrap">{d.mapSettings.near.split(/, (?=\d)/).map((a: string) => <li>{a.trim()}</li>)}</ul>
          </div>
        </div>
        <div class="map-add">
          <p class="col-head">{t.additional}</p>
          <ul class="game-list" style="white-space:nowrap">{d.mapSettings.additional.split(/, (?=\d)/).map((a: string) => <li>{a.trim()}</li>)}</ul>
        </div>
      </section>

      <!-- ГОРОД -->
      <section class="tab-pane" id="pane-town">
        <h1 class="stage-title">{t.townTitle}</h1>
        <div class="visual">
          <button class="nav-arrow" data-dir="-1"><img src={img('ui/arrow-left.png')} alt="◄" onerror="this.parentNode.textContent='◄'" /></button>
          <img class="visual-img" src={img(ASSETS + '/town.png')} alt="Town" onerror="this.style.display='none'" />
          <button class="nav-arrow" data-dir="1"><img src={img('ui/arrow-right.png')} alt="►" onerror="this.parentNode.textContent='►'" /></button>
        </div>
        <div class="squares">
          {['map', 'town', 'hero', 'ai', 'win'].map((tab) => (
            <button class="sq" data-goto={tab}></button>
          ))}
        </div>
        <h3 class="set-title" style="text-align:left">{t.townSettings}</h3>
        <div class="three-col">
          <div>
            <p class="col-head">{t.buildings}</p>
            <ul class="game-list" style="white-space:nowrap">
                           {d.mainTown.buildings.map((b: any) => (
                <li>{b.name} <span class={BICON[b.icon] || 'star-o'}>{BCHAR[b.icon] || '★'}</span></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="col-head">{t.production}</p>
            <ul class="game-list" style="white-space:nowrap">{prod.map((n: string, i: number) => <li class="res-line">{n} <img src={img('ui/' + resIcons[i])} alt="" onerror="this.style.display='none'" /></li>)}</ul>
          </div>
          <div>
            <p class="col-head">{t.startRes}</p>
            <ul class="game-list" style="white-space:nowrap">{res.map((n: string, i: number) => <li class="res-line">{n} <img src={img('ui/' + resIcons[i])} alt="" onerror="this.style.display='none'" /></li>)}</ul>
          </div>
        </div>
      </section>

    <!-- ГЕРОЙ -->
      <section class="tab-pane" id="pane-hero">
        <h1 class="stage-title">{t.heroTitle}</h1>
        <div class="visual">
          <button class="nav-arrow" data-dir="-1"><img src={img('ui/arrow-left.png')} alt="◄" onerror="this.parentNode.textContent='◄'" /></button>
          <div style="width:100%;display:flex;flex-direction:column;align-items:center;gap:10px">
            {heroBlocks.length > 1 && (
              <div style="display:flex;gap:10px;justify-content:center">
                {heroBlocks.map((hb: any, hi: number) => (
                  <button class="btn" data-hero-btn={hi} style={hi === 0 ? 'box-shadow:0 0 0 2px #e9c464' : ''}>{hb.name}</button>
                ))}
              </div>
            )}
            {heroBlocks.map((hb: any, hi: number) => (
              <div class="hero-grid" data-hero-block={hi} style={hi === 0 ? '' : 'display:none'}>
                <img class="hero-img" src={hb.imgSrc} alt="" onerror="this.style.display='none'" />
                <div class="hg-stats">
                  <p class="hand-title">{t.handDeckTitle}</p>
                  <div class="cards-row">
                    {hb.stats.map((o: any) => (
                      <div class="card-wrap">
                        <img class="card-img" src={base + 'images/' + cardPaths(o.c, 'stat')[0]} data-fallback={fbAttr(cardPaths(o.c, 'stat'))} onerror={ONERR} alt="" />
                        <span class="card-count">{o.n}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="cards-row hg-units">
                  {hb.units.map((c: string) => (
                    <div class="card-wrap"><img class="card-img small" src={base + 'images/' + cardPaths(c, 'unit')[0]} data-fallback={fbAttr(cardPaths(c, 'unit'))} onerror={ONERR} alt="" /></div>
                  ))}
                </div>
                <div class="cards-row hg-skills">
                  {hb.skills.map((o: any) => (
                    <div class="card-wrap">
                      <img class="card-img small" src={base + 'images/' + cardPaths(o.c, o.kind)[0]} data-fallback={fbAttr(cardPaths(o.c, o.kind))} onerror={ONERR} alt="" />
                      <span class="card-count">{o.n}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <button class="nav-arrow" data-dir="1"><img src={img('ui/arrow-right.png')} alt="►" onerror="this.parentNode.textContent='►'" /></button>
        </div>
        <div class="squares">
          {['map', 'town', 'hero', 'ai', 'win'].map((tab) => (
            <button class="sq" data-goto={tab}></button>
          ))}
        </div>
        <h3 class="set-title" style="text-align:left">{t.heroSettings}</h3>
        <div class="two-col">
          <div>
            <p class="col-head">{t.army}</p>
            {heroBlocks.map((hb: any, hi: number) => (
              <div data-hero-block={hi} style={hi === 0 ? '' : 'display:none'}>
                <ul class="game-list" style="white-space:nowrap">{hb.army.split(',').map((a: string) => <li set:html={a.trim() + starFor(a)} />)}</ul>
              </div>
            ))}
          </div>
          <div>
            <p class="col-head">{t.yourDeck}</p>
            {heroBlocks.map((hb: any, hi: number) => (
              <div data-hero-block={hi} style={hi === 0 ? '' : 'display:none'}>
                <ul class="game-list" style="white-space:nowrap">{hb.hand.map((c: string) => <li set:html={deckHtml(c)} />)}</ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ИИ -->
      <section class="tab-pane" id="pane-ai">
        <h1 class="stage-title">{t.aiTitle}</h1>
        <div class="visual">
          <button class="nav-arrow" data-dir="-1"><img src={img('ui/arrow-left.png')} alt="◄" onerror="this.parentNode.textContent='◄'" /></button>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;width:100%;max-width:980px;align-items:start">
            {aiSorted.map((ai: any) => (
              <div style="border:1px solid #a8863c;background:rgba(0,0,0,.15);padding:8px 6px;min-width:0">
                <p style="color:#e9c464;text-align:center;font-size:.95rem;margin-bottom:4px">{lang === 'ru' ? 'Армия ' + ai.name + ':' : ai.name + "'s Army:"}</p>
                {ai.armyCards && ai.armyCards.length ? (
                  <div style="display:grid;grid-template-columns:repeat(2,auto);justify-content:center;gap:6px">
                    {ai.armyCards.map((card: any) => (
                      <div style="border:none;background:none;padding:2px;min-width:0">
                        <img src={cardImg(card).src} data-fallback={cardImg(card).fb} onerror={ONERR} alt={card.title || ''} style="display:block;width:auto;height:96px;max-width:100%" />
                      </div>
                    ))}
                  </div>
                ) : (
                  <img src={img(ASSETS + '/ai/' + (ai.name === 'Aislinn' || ai.name === 'Эйслин' ? 'aislinn.png' : ai.name === 'Galthran' || ai.name === 'Галтрана' ? 'galthran.png' : 'town-army.png'))} alt="" style="max-height:240px;max-width:100%;display:block;margin:0 auto" onerror="this.style.display='none'" />
                )}
              </div>
            ))}
          </div>
          <button class="nav-arrow" data-dir="1"><img src={img('ui/arrow-right.png')} alt="►" onerror="this.parentNode.textContent='►'" /></button>
        </div>
        <div class="squares">
          {['map', 'town', 'hero', 'ai', 'win'].map((tab) => (
            <button class="sq" data-goto={tab}></button>
          ))}
        </div>
        <div class="ai-cols">
          {aiSorted.map((ai: any) => (
            <div>
              <h3 class="set-title" style="text-align:left;font-size:1.05rem">{lang === 'ru' ? 'Настройки ' + ai.name + ':' : ai.name + ' Settings:'}</h3>
              <div class="ai-sub" style="display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap">
                <div>
                  <p class="col-head">{t.army}</p>
                  <ul class="game-list" style="white-space:nowrap;font-size:.82rem">{ai.army.split(',').map((a: string) => <li set:html={a.trim() + starFor(a)} />)}</ul>
                </div>
                {ai.deck && (
                  <div>
                    <p class="col-head">{t.aiDeck}</p>
                    <ul class="game-list" style="font-size:.82rem">{ai.deck.split(',').map((a: string) => <li set:html={deckHtml(a.trim())} />)}</ul>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- УСЛОВИЯ ПОБЕДЫ -->
      <section class="tab-pane" id="pane-win">
        <h1 class="stage-title">{t.winTitle}</h1>
        <div class="visual">
          <button class="nav-arrow" data-dir="-1"><img src={img('ui/arrow-left.png')} alt="◄" onerror="this.parentNode.textContent='◄'" /></button>
          <div class="win-cols">
            <div>
              <p class="col-head">{t.goals}</p>
              <ul class="win-list">{d.goals.map((g: string) => <li>{g}</li>)}</ul>
              <p class="col-head" style="margin-top:1.4rem">{t.lose}</p>
              <ul class="win-list">{d.loseConditions.map((g: string) => <li>{g}</li>)}</ul>
            </div>
            <div>
              <p class="col-head">{t.rules}</p>
              <ul class="win-list">{d.additionalRules.map((g: string) => <li>{g}</li>)}</ul>
            </div>
          </div>
          <button class="nav-arrow" data-dir="1"><img src={img('ui/arrow-right.png')} alt="►" onerror="this.parentNode.textContent='►'" /></button>
        </div>
        <div class="squares">
          {['map', 'town', 'hero', 'ai', 'win'].map((tab) => (
            <button class="sq" data-goto={tab}></button>
          ))}
        </div>
      </section>
    </main>

    <!-- ПРАВАЯ ПАНЕЛЬ -->
    <aside class="sidebar" id="sidebar">
      <i class="corner c1"></i><i class="corner c2"></i><i class="corner c3"></i><i class="corner c4"></i>
      <p class="desc">{d.description}</p>

      <div class="checklist">
        <div class="check-head">{t.check}</div>
        <button class="check-item" data-tab="map"><img class="ic no" src={img('ui/check-no.png')} alt="" onerror="this.style.display='none'" /><img class="ic yes" src={img('ui/check-yes.png')} alt="" onerror="this.style.display='none'" />{t.tabMap}</button>
        <button class="check-item" data-tab="town"><img class="ic no" src={img('ui/check-no.png')} alt="" onerror="this.style.display='none'" /><img class="ic yes" src={img('ui/check-yes.png')} alt="" onerror="this.style.display='none'" />{t.tabTown}</button>
        <button class="check-item" data-tab="hero"><img class="ic no" src={img('ui/check-no.png')} alt="" onerror="this.style.display='none'" /><img class="ic yes" src={img('ui/check-yes.png')} alt="" onerror="this.style.display='none'" />{t.tabHero}</button>
        <button class="check-item" data-tab="ai"><img class="ic no" src={img('ui/check-no.png')} alt="" onerror="this.style.display='none'" /><img class="ic yes" src={img('ui/check-yes.png')} alt="" onerror="this.style.display='none'" />{t.tabAi}</button>
        <button class="check-item" data-tab="win"><img class="ic no" src={img('ui/check-no.png')} alt="" onerror="this.style.display='none'" /><img class="ic yes" src={img('ui/check-yes.png')} alt="" onerror="this.style.display='none'" />{t.tabWin}</button>
      </div>

      <div class="meta-row"><span id="bonus-label">{BONUSES[0]}</span><span id="diff-label">{t.diffNames[0]}</span></div>

      <div class="resources">
        {bonusIcons.map((ic, i) => (
          <button class:list={['res-slot', { selected: i === 0 }]} data-bonus={i} data-name={BONUSES[i]}><img src={img('ui/' + ic)} alt="" onerror="this.outerHTML='🎁'" /></button>
        ))}
        <button class="res-slot" id="diff-slot" title="difficulty">
          <img class="chess-img" id="chess-img" src={img('ui/pawn.png')} alt=""
            onerror="this.style.display='none';document.getElementById('chess-fb').style.display='block';"
            onload="this.style.display='block';document.getElementById('chess-fb').style.display='none';" />
          <span class="chess-fb" id="chess-fb" style="display:none">♔</span>
        </button>
      </div>

      <div class="btn-row">
        <button class="btn" id="begin-btn" disabled>{t.begin}</button>
        <a class="btn" href={`${base}${lang}/`}>{t.back}</a>
      </div>
    </aside>

    <GameConsole mission={mission} lang={lang} base={base} />
  </div>

  <div class="bottombar">
    <button class="btn" id="bgm-toggle">🔊</button>
        <a class="flag" class:list={[{ active: lang === 'ru' }]} href={`${base}ru/`}><img src={img('ui/flag-ru.png')} alt="RU" onerror="this.style.display='none'" />🇷🇺</a>
    <a class="flag" class:list={[{ active: lang === 'en' }]} href={`${base}en/`}><img src={img('ui/flag-en.png')} alt="EN" onerror="this.style.display='none'" />🇬🇧</a>
    <a class="flag" href="https://www.donationalerts.com/r/azanomat" target="_blank" rel="noopener" title={lang === 'ru' ? 'Угостите меня кофе' : 'Buy me a coffee'} style="text-decoration:none">
      <img src={img('ui/coffee.png')} alt="☕" style="width:100%;height:100%;object-fit:contain" onerror="this.onerror=null;this.outerHTML='<span style=&quot;font-size:1.7rem;line-height:1&quot;>☕</span>'" />
    </a>
    <span class="lang-slot"></span>
    <span class="lang-slot dark"></span>
    <span class="lang-slot"></span>
    <span class="lang-slot"></span>
  </div>

     <script define:vars={{ base }}>
        const applyZoom = () => { document.documentElement.style.zoom = (window.innerWidth / 1280).toFixed(3); };
    applyZoom(); window.addEventListener('resize', applyZoom);

    const langNow = document.documentElement.lang;
    const order = ['map', 'town', 'hero', 'ai', 'win'];
    let current = 'map';
    let started = false;
    let diffIdx = 0;
    let bonusIdx = 0;
    const visited = new Set();

    const items = Array.from(document.querySelectorAll('.check-item'));
    const panes = Array.from(document.querySelectorAll('.tab-pane'));
    const beginBtn = document.getElementById('begin-btn');
    const bonusLabel = document.getElementById('bonus-label');
    const diffLabel = document.getElementById('diff-label');

    const bonusNamesL = langNow === 'ru' ? ['Руда', 'Кристаллы', 'Ammo Cart War Machine'] : ['Ore', 'Crystals', 'Ammo Cart War Machine'];
    const names4 = langNow === 'ru' ? ['Лёгкий', 'Средний', 'Сложный', 'Невозможный'] : ['Easy', 'Medium', 'Hard', 'Impossible'];
    const imgs4 = ['pawn.png', 'knight.png', 'rook.png', 'king.png'];
    const pieces4 = ['♙', '♘', '♖', '♔'];

    function squaresUpdate() {
      const n = started ? 5 : order.indexOf(current) + 1;
      document.querySelectorAll('.squares').forEach((sq) =>
        Array.from(sq.children).forEach((s, i) => s.classList.toggle('filled', i < n)));
    }
    function beginUpdate() {
      beginBtn.disabled = !(visited.size >= 5 && diffIdx >= 0 && bonusIdx >= 0);
    }
    function go(tab) {
      if (started || tab === current) return;
      visited.add(current);
      if (tab === 'win') visited.add('win');
      items.forEach((b) => {
        const t2 = b.getAttribute('data-tab');
        b.classList.toggle('active', t2 === tab);
        b.classList.toggle('visited', visited.has(t2));
      });
      panes.forEach((p) => p.classList.toggle('active', p.id === 'pane-' + tab));
      current = tab;
      squaresUpdate(); beginUpdate();
    }

    items.forEach((b) => b.addEventListener('click', () => go(b.getAttribute('data-tab'))));
        document.querySelectorAll('.sq').forEach((b) =>
      b.addEventListener('click', () => go(b.getAttribute('data-goto'))));
    document.querySelectorAll('.nav-arrow[data-dir]').forEach((a) =>
      a.addEventListener('click', () => {
        const dir = Number(a.getAttribute('data-dir'));
        const i = Math.min(order.length - 1, Math.max(0, order.indexOf(current) + dir));
        go(order[i]);
      }));

    document.querySelectorAll('.res-slot[data-bonus]').forEach((s) =>
      s.addEventListener('click', () => {
        bonusIdx = Number(s.getAttribute('data-bonus'));
        document.querySelectorAll('.res-slot[data-bonus]').forEach((x) => x.classList.toggle('selected', x === s));
                bonusLabel.textContent = s.dataset.name || bonusNamesL[bonusIdx];
        beginUpdate();
      }));

    const diffSlot = document.getElementById('diff-slot');
    const chessImg = document.getElementById('chess-img');
    const chessFb = document.getElementById('chess-fb');
    diffSlot.addEventListener('click', () => {
      diffIdx = (diffIdx + 1) % 4;
      diffLabel.textContent = names4[diffIdx];
      if (chessImg) chessImg.src = base + 'images/ui/' + imgs4[diffIdx];
      if (chessFb) chessFb.textContent = pieces4[diffIdx];
      beginUpdate();
    });
    document.querySelectorAll('[data-hero-btn]').forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.getAttribute('data-hero-btn'));
      document.querySelectorAll('[data-hero-btn]').forEach((x) => { x.style.boxShadow = (x === b) ? '0 0 0 2px #e9c464' : ''; });
      document.querySelectorAll('[data-hero-block]').forEach((g) => { g.style.display = (Number(g.getAttribute('data-hero-block')) === i) ? '' : 'none'; });
    }));
        document.querySelectorAll('.faction-slot').forEach((slot) => {
      const pop = slot.querySelector('.faction-pop');
      slot.addEventListener('mouseenter', () => { if (pop) pop.style.display = 'flex'; });
      slot.addEventListener('mouseleave', () => { if (pop) pop.style.display = 'none'; });
    });
    beginBtn.addEventListener('click', () => {
      started = true;
      document.getElementById('stage').style.display = 'none';
      document.getElementById('sidebar').style.display = 'none';
      panes.forEach((p) => p.classList.remove('active'));
      squaresUpdate();
      window.dispatchEvent(new CustomEvent('game:start', { detail: { diff: diffIdx, bonus: bonusIdx } }));
    });

    const click = new Audio(base + 'audio/click.mp3');
        document.addEventListener('click', (e) => {
      if (e.target.closest('button, a.flag')) { click.currentTime = 0; click.play().catch(() => {}); }
    }, true);
    const tabS = new Audio(base + 'audio/tab-switch.mp3');
    document.querySelectorAll('.check-item, .nav-arrow, .res-slot, #diff-slot, .btn').forEach((el) =>
      el.addEventListener('click', () => { tabS.currentTime = 0; tabS.play().catch(() => {}); }));
    document.querySelectorAll('.flag').forEach((el) =>
      el.addEventListener('click', () => { click.currentTime = 0; click.play().catch(() => {}); }));

    squaresUpdate(); beginUpdate();
  </script>
</body>
</html>