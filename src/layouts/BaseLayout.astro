---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  lang: string;
  title: string;
}

const { lang, title } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Heroes III Board Game</title>
  <meta name="description" content="Heroes of Might and Magic III - Board Game Scenarios" />
</head>
<body>
  <Header lang={lang} />
  <main>
    <slot />
  </main>
  <footer style="text-align:center; padding:2rem; color:var(--color-text-muted); font-size:0.85rem;">
    Heroes of Might and Magic III: The Board Game — Fan Scenario Archive
  </footer>
</body>
</html>
